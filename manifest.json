{
  "manifest_version": 3,
  "name": "Vercel Folders",
  "version": "0.1.0",
  "description": "Organize your Vercel projects into folders.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://vercel.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
