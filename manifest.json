{
  "manifest_version": 3,
  "name": "Vercel Folders",
  "version": "0.1.0",
  "description": "Organize your Vercel projects into folders.",
  "permissions": ["storage"],
  "host_permissions": ["https://vercel.com/*"],
  "content_scripts": [
    {
      "matches": ["https://vercel.com/*"],
      "js": ["dist/content.js"],
      "css": ["dist/content.css"]
    }
  ]
}
